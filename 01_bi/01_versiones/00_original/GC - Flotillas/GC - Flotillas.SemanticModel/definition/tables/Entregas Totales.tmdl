table 'Entregas Totales'
	lineageTag: 93060b2a-375c-4d50-968b-1547fed5fa65

	measure 'cantidad de maquinas' = IF(COUNTROWS('Entregas Totales')=0,0,COUNTROWS('Entregas Totales'))
		formatString: #,0
		lineageTag: bf1225e0-e20f-4b78-92af-7b1716c7f12e

	measure Medida
		lineageTag: 8e2854d0-05a5-4afa-b723-e627a276907b

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure S1 = IF(CALCULATE([cantidad de maquinas],'Entregas Totales'[DIVISION S]="S1")=0,0,CALCULATE([cantidad de maquinas],'Entregas Totales'[DIVISION S]="S1"))
		formatString: #,0
		lineageTag: b416919b-0793-4867-8b37-933b454de8fb

	measure S2 = IF(CALCULATE([cantidad de maquinas],'Entregas Totales'[DIVISION S]="S2")=0,0,CALCULATE([cantidad de maquinas],'Entregas Totales'[DIVISION S]="S2"))
		formatString: #,0
		lineageTag: 49f6cace-cdaa-4343-b937-54f3566072d4

	measure 'Recambio semestral' = IF('Entregas Totales'[cantidad de maquinas]=0,0,IF(([S2]-[S1])/[S2]<=0,0,([S2]-[S1])/[S2]))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: af443139-00f4-4345-b9ee-b847f2babfab

	measure 'Recambio anual (vs año ant.)' = IF(IF([cantidad de maquinas]=0,0,([Año actual]-[Año Anterior])/[Año Anterior])>1,1,IF([cantidad de maquinas]=0,0,([Año actual]-[Año Anterior])/[Año Anterior]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: fcf33b75-6f4e-46bd-8e6a-189513deadb9

	measure 'Año actual' = CALCULATE([cantidad de maquinas],'Entregas Totales'[año]=MAX('Entregas Totales'[año]))
		formatString: 0
		lineageTag: cace1f24-fd56-4655-a098-3b24d13e78b8

	measure 'Año Anterior' = CALCULATE([cantidad de maquinas],'Entregas Totales'[año]=MAX('Entregas Totales'[año])-1)
		formatString: 0
		lineageTag: 5e65ec2b-b63c-4038-8140-d68832f20c73

	measure 'Medida 2' = CALCULATE([cantidad de maquinas],'Entregas Totales'[año]=MAX('Entregas Totales'[año])-1)
		formatString: 0
		lineageTag: d96eb974-557d-4111-9838-b22f90197c83

	measure Q1 = IF(CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q1")=0,0,CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q1"))
		formatString: #,0
		lineageTag: 7e67ca90-bf72-4fe8-b562-2f2a1546a1cf

	measure Q2 = IF(CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q2")=0,0,CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q2"))
		formatString: #,0
		lineageTag: 672472d1-723e-4c64-bbf6-2396df0f84b7

	measure Q3 = IF(CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q3")=0,0,CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q3"))
		formatString: #,0
		lineageTag: f3616dc2-c871-4bc2-a680-bd14517e80bb

	measure Q4 = IF(CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q4")=0,0,CALCULATE([cantidad de maquinas],'Entregas Totales'[Q]="Q4"))
		formatString: #,0
		lineageTag: aba32d58-0bb4-4436-8a38-2f443bcfb31d

	measure 'Crecimiento Q1→Q4' = IF([Q4]=0,0,IF(([Q4]-[Q1])/[Q1]>1,1,([Q4]-[Q1])/[Q1]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 48bb01d7-3243-4200-a84a-14ba38ef6138

	measure 'Ticket promedio' = SUM('Entregas Totales'[Valor])/[cantidad de maquinas]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 8a477545-83ea-4fc9-ab75-e12f341f139e

