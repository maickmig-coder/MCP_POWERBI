			        IF(left('Entregas Totales'[Centro],2)<>"VO" && [Marca]="Implementos","JD Agricola",
			        IF(left('Entregas Totales'[Centro],2)<>"VO" && [Marca]="vibromax","JD Agricola",
			        IF(left('Entregas Totales'[Centro],2)<>"VO" && [Marca]="hyundai","JD Agricola",
